{
  "name": "paquetex",
  "version": "4.0.0",
  "description": "Sistema de gestión de paquetería",
  "scripts": {
    "build:css": "npm run build:css:legacy && npm run build:css:rebuild",
    "build:css:legacy": "tailwindcss -i ./src/static/css/input.css -o ./src/static/css/tailwind.css --minify",
    "build:css:rebuild": "tailwindcss -i ./src/static/css/input.css -o ./src/app/web/static/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/static/css/input.css -o ./src/static/css/tailwind.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.1"
  }
}
