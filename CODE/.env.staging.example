# ========================================
# PAQUETEX EL CLUB - STAGING ENVIRONMENT
# ========================================
# Base de datos: paqueteria_staging (SEPARADA de producción)
# Puerto: 8001 (para no conflictuar con producción)
# ========================================

# Configuración de la Aplicación
APP_NAME="PAQUETEX EL CLUB - STAGING"
APP_VERSION=4.0.0-staging
DEBUG=True
ENVIRONMENT=staging

# Configuración de zona horaria
TZ=America/Bogota

# ========================================
# Base de Datos PostgreSQL (AWS RDS) - STAGING
# ========================================
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/paqueteria_staging
POSTGRES_DB=paqueteria_staging
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
POSTGRES_HOST=your-rds-host.amazonaws.com
POSTGRES_PORT=5432

# ========================================
# Conexión a Producción (SOLO LECTURA para sincronización)
# ========================================
PROD_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/paqueteria_v4

# Cache Redis (Puerto 6380 para evitar conflictos con producción)
REDIS_PASSWORD=your_redis_password
REDIS_URL=redis://:your_redis_password@redis:6380/0
REDIS_HOST=redis
REDIS_PORT=6380

# Seguridad
SECRET_KEY=your-staging-secret-key-different-from-prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Configuración SMTP (Email)
SMTP_HOST=your.smtp.host
SMTP_PORT=587
SMTP_USER=your_email@domain.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_NAME="PAQUETEX EL CLUB - STAGING"
SMTP_FROM_EMAIL=your_email@domain.com
SMTP_USE_TLS=True
SMTP_USE_SSL=False

# Configuración SMS (LIWA.co)
LIWA_API_KEY=your_liwa_api_key
LIWA_ACCOUNT=your_account
LIWA_PASSWORD=your_liwa_password
LIWA_AUTH_URL=https://api.liwa.co/v2/auth/login
LIWA_FROM_NAME="PAQUETEX EL CLUB - STAGING"

# Configuración de Tarifas
CURRENCY=COP

# Configuración de Archivos
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=5242880
MAX_FILE_SIZE_MB=5
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp
ALLOWED_DOCUMENT_TYPES=pdf,doc,docx
MAX_FILE_UPLOADS=3

# Configuración AWS S3 (Mismo bucket pero con prefijo staging/)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=your-bucket-name
AWS_REGION=us-east-1
S3_PREFIX=staging/
S3_PREFIX_PROVIDER_PDFS=staging/provider-pdfs/
S3_PREFIX_DIAN_PDFS=staging/dian-pdfs/

# Configuración de la Empresa
COMPANY_NAME="PAQUETEX EL CLUB - STAGING"
COMPANY_DISPLAY_NAME="PAQUETEX EL CLUB - STAGING"
COMPANY_SHORT_NAME=PEC-STG
COMPANY_ADDRESS="Cra. 91 #54-120, Local 12"
COMPANY_PHONE=3334004007
COMPANY_EMAIL=paquetex@papyrus.com.co
COMPANY_WEBSITE=https://paquetex.papyrus.com.co

# Configuración Geográfica
DEFAULT_COUNTRY=Colombia
DEFAULT_TIMEZONE=America/Bogota
DEFAULT_PHONE_PREFIX=+57
DEFAULT_PHONE_LENGTH=10

# URLs y Dominios
PRODUCTION_URL=https://paquetex.papyrus.com.co
DEVELOPMENT_URL=http://localhost:8001
TRACKING_BASE_URL=http://localhost:8001/search

# Configuración de Mensajes SMS
SMS_DAILY_LIMIT=1000
SMS_MONTHLY_LIMIT=30000
SMS_MAX_MESSAGE_LENGTH=2000
SMS_DEFAULT_SENDER="PAQUETEX EL CLUB - STAGING"

# Plantillas de Mensajes SMS
SMS_ANNOUNCEMENT_TEMPLATE="[STAGING] PAQUETES EL CLUB: Su paquete con guía {guide_number} ha sido anunciado. Código: {tracking_code}. Más info: {tracking_url}"
SMS_RECEIVED_TEMPLATE="[STAGING] PAQUETES EL CLUB: Su paquete {guide_number} ha sido RECIBIDO en nuestras instalaciones. Código: {tracking_code}."
SMS_DELIVERED_TEMPLATE="[STAGING] PAQUETES EL CLUB: ¡Su paquete {guide_number} ha sido ENTREGADO exitosamente! Código: {tracking_code}."
SMS_CANCELLED_TEMPLATE="[STAGING] PAQUETES EL CLUB: Su paquete {guide_number} ha sido CANCELADO. Código: {tracking_code}."
SMS_PAYMENT_REMINDER_TEMPLATE="[STAGING] PAQUETES EL CLUB: Tiene un pago pendiente por ${amount} COP para el paquete {guide_number}."

# Configuración de UI
TOAST_DEFAULT_DURATION=5000
TOAST_SUCCESS_DURATION=3000
TOAST_ERROR_DURATION=5000
TOAST_INFO_DURATION=2000
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Datos de Prueba
TEST_PHONE_NUMBER_1=3000000000
TEST_PHONE_NUMBER_2=3001234567
TEST_PHONE_NUMBER_3=3009876543

# Configuración de Logs
LOG_LEVEL=DEBUG
LOG_FILE=/app/logs/app.log
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"

# Configuración de PWA
PWA_NAME="PAQUETEX EL CLUB - STAGING"
PWA_SHORT_NAME=Paquetex-STG
PWA_DESCRIPTION="Sistema de gestión de paquetería - Staging"
PWA_THEME_COLOR=#FFA500
PWA_BACKGROUND_COLOR=#FFFFFF

# Puerto de aplicación
APP_PORT=8000
HOST=0.0.0.0
PORT=8000

# CORS
ALLOWED_ORIGINS=http://localhost:8001,http://127.0.0.1:8001,http://localhost:8000,http://127.0.0.1:8000

# Features Flags
ENABLE_AUTO_MATCHING=True
ENABLE_S3_CLEANUP=False
ENABLE_EMAIL_NOTIFICATIONS=True

# DIAN
DIAN_BASE_URL=https://catalogo-vpfe.dian.gov.co
DIAN_TIMEOUT=30

# Límites
MAX_FILE_SIZE=52428800
MAX_FILES_PER_UPLOAD=10
REQUEST_TIMEOUT=60
